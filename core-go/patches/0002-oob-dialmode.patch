diff --git a/transport/internet/dialmode.go b/transport/internet/dialmode.go
new file mode 100644
index 0000000..ead159b
--- /dev/null
+++ b/transport/internet/dialmode.go
@@ -0,0 +1,36 @@
+package internet
+
+import (
+	"strconv"
+	"strings"
+)
+
+// DialModeOOBPrefix marks the "oob.<b1>,<b2>,..." dial mode family.
+//
+// Each listed byte is appended to one of the first writes on the dialed TCP connection and that
+// write is sent with the TCP urgent (MSG_OOB) flag; later writes pass through untouched. A
+// conforming peer's kernel removes the urgent byte from the stream, so the application sees the
+// original bytes, while a middlebox that mishandles the urgent pointer desynchronises on those
+// segments — usually on the TLS ClientHello.
+const DialModeOOBPrefix = "oob."
+
+// ParseOOBMode returns the byte list for an "oob." mode, and false when the syntax is invalid.
+func ParseOOBMode(mode string) ([]byte, bool) {
+	if !strings.HasPrefix(mode, DialModeOOBPrefix) {
+		return nil, false
+	}
+	list := mode[len(DialModeOOBPrefix):]
+	if list == "" {
+		return nil, false
+	}
+	parts := strings.Split(list, ",")
+	out := make([]byte, 0, len(parts))
+	for _, part := range parts {
+		n, err := strconv.Atoi(strings.TrimSpace(part))
+		if err != nil || n < 0 || n > 255 {
+			return nil, false
+		}
+		out = append(out, byte(n))
+	}
+	return out, true
+}
diff --git a/transport/internet/dialmode_oob.go b/transport/internet/dialmode_oob.go
new file mode 100644
index 0000000..bab0a3a
--- /dev/null
+++ b/transport/internet/dialmode_oob.go
@@ -0,0 +1,59 @@
+//go:build unix || windows
+
+package internet
+
+import (
+	"syscall"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+// oobConn appends one byte per leading write and sends that write as TCP urgent data.
+type oobConn struct {
+	net.Conn
+	bytes []byte
+	used  int
+}
+
+func wrapOOB(conn net.Conn, bytes []byte) net.Conn {
+	return &oobConn{Conn: conn, bytes: bytes}
+}
+
+func (c *oobConn) Write(p []byte) (int, error) {
+	if c.used >= len(c.bytes) {
+		return c.Conn.Write(p)
+	}
+	urgent := c.bytes[c.used]
+	c.used++
+
+	sc, ok := c.Conn.(syscall.Conn)
+	if !ok {
+		return c.Conn.Write(p)
+	}
+	raw, err := sc.SyscallConn()
+	if err != nil {
+		return c.Conn.Write(p)
+	}
+
+	buf := make([]byte, len(p)+1)
+	copy(buf, p)
+	buf[len(p)] = urgent
+
+	var sendErr error
+	ctrlErr := raw.Write(func(fd uintptr) bool {
+		_, e := sendUrgent(fd, buf)
+		if e == syscall.EAGAIN || e == syscall.EWOULDBLOCK {
+			return false
+		}
+		sendErr = e
+		return true
+	})
+	if ctrlErr != nil {
+		return 0, ctrlErr
+	}
+	if sendErr != nil {
+		return 0, sendErr
+	}
+	// The urgent byte is not part of p: report only what the caller asked for.
+	return len(p), nil
+}
