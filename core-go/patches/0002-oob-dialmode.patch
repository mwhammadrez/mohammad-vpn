diff --git a/transport/internet/dialmode_oob_unix.go b/transport/internet/dialmode_oob_unix.go
new file mode 100644
index 0000000..eaa20ae
--- /dev/null
+++ b/transport/internet/dialmode_oob_unix.go
@@ -0,0 +1,13 @@
+//go:build unix
+
+package internet
+
+import "golang.org/x/sys/unix"
+
+// sendUrgent sends b with the TCP urgent flag; the last byte becomes the urgent byte.
+func sendUrgent(fd uintptr, b []byte) (int, error) {
+	if err := unix.Send(int(fd), b, unix.MSG_OOB); err != nil {
+		return 0, err
+	}
+	return len(b), nil
+}
diff --git a/transport/internet/dialmode_oob_windows.go b/transport/internet/dialmode_oob_windows.go
new file mode 100644
index 0000000..895a7ed
--- /dev/null
+++ b/transport/internet/dialmode_oob_windows.go
@@ -0,0 +1,15 @@
+//go:build windows
+
+package internet
+
+import "golang.org/x/sys/windows"
+
+func sendUrgent(fd uintptr, b []byte) (int, error) {
+	if len(b) == 0 {
+		return 0, nil
+	}
+	buf := windows.WSABuf{Len: uint32(len(b)), Buf: &b[0]}
+	var sent uint32
+	err := windows.WSASend(windows.Handle(fd), &buf, 1, &sent, windows.MSG_OOB, nil, nil)
+	return int(sent), err
+}
