@@ -0,0 +1,172 @@
+package merge
+
+import (
+	"errors"
+	"net"
+	"sync"
+	"syscall"
+	"time"
+)
+
+// conn coalesces the client->server side of a connection.
+//
+// While it still has budget, every Write is copied into a buffer instead of being sent. The buffer
+// leaves as a single socket write when either no new Write arrives for `delay`, or the buffer reaches
+// `maxBytes` — whichever comes first. Every flush spends one unit of budget; at zero the connection
+// switches to a plain pass-through for the rest of its life, so an interactive session pays the delay
+// only for its first few writes and never again.
+//
+// Why: a filter that keys on "the first small outbound segment" (a bare ClientHello, a short WS
+// header) sees one full-sized segment instead. It is the mirror image of fragmentation, which splits
+// writes that would otherwise be recognised.
+//
+// The read side is never touched: server->client bytes pass straight through.
+type conn struct {
+	net.Conn
+
+	delay    time.Duration
+	maxBytes int
+
+	mu      sync.Mutex
+	buf     []byte
+	left    int
+	gen     uint64
+	timer   *time.Timer
+	closed  bool
+	direct  bool
+	err     error
+}
+
+// newConn applies the defaults in one place so a bare Config, a JSON mask and a protobuf message
+// built by hand all behave the same way.
+func newConn(inner net.Conn, cfg *Config) net.Conn {
+	times := int(cfg.GetTimes())
+	if times <= 0 {
+		times = defaultTimes
+	}
+	delayMs := int(cfg.GetDelayMs())
+	if delayMs <= 0 {
+		delayMs = defaultDelayMs
+	}
+	maxBytes := int(cfg.GetMaxBytes())
+	if maxBytes <= 0 {
+		maxBytes = defaultMaxBytes
+	}
+	return &conn{
+		Conn:     inner,
+		delay:    time.Duration(delayMs) * time.Millisecond,
+		maxBytes: maxBytes,
+		left:     times,
+	}
+}
+
+func (c *conn) Write(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	c.mu.Lock()
+	if c.err != nil {
+		err := c.err
+		c.mu.Unlock()
+		return 0, err
+	}
+	if c.closed {
+		c.mu.Unlock()
+		return 0, net.ErrClosed
+	}
+	if c.direct {
+		c.mu.Unlock()
+		return c.Conn.Write(p)
+	}
+
+	// append copies p, so the caller may reuse its slice as soon as Write returns.
+	c.buf = append(c.buf, p...)
+	if len(c.buf) >= c.maxBytes {
+		data := c.buf
+		c.buf = nil
+		c.stopTimerLocked()
+		err := c.flushLocked(data)
+		c.mu.Unlock()
+		if err != nil {
+			return 0, err
+		}
+		return len(p), nil
+	}
+	c.armLocked()
+	c.mu.Unlock()
+	return len(p), nil
+}
+
+// armLocked starts the idle timer for the current buffer. Bumping `gen` makes any timer that has
+// already fired but is still waiting for the lock a no-op, which avoids the Timer.Reset race.
+func (c *conn) armLocked() {
+	c.gen++
+	gen := c.gen
+	if c.timer != nil {
+		c.timer.Stop()
+	}
+	c.timer = time.AfterFunc(c.delay, func() { c.onIdle(gen) })
+}
+
+func (c *conn) stopTimerLocked() {
+	c.gen++
+	if c.timer != nil {
+		c.timer.Stop()
+	}
+}
+
+func (c *conn) onIdle(gen uint64) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || c.direct || c.err != nil || gen != c.gen || len(c.buf) == 0 {
+		return
+	}
+	data := c.buf
+	c.buf = nil
+	_ = c.flushLocked(data)
+}
+
+// flushLocked sends one buffer and spends a unit of budget. Caller holds c.mu.
+func (c *conn) flushLocked(data []byte) error {
+	if len(data) == 0 {
+		return nil
+	}
+	if _, err := c.Conn.Write(data); err != nil {
+		c.err = err
+		return err
+	}
+	if c.left > 0 {
+		c.left--
+	}
+	if c.left == 0 {
+		c.direct = true
+	}
+	return nil
+}
+
+func (c *conn) Close() error {
+	c.mu.Lock()
+	if c.closed {
+		c.mu.Unlock()
+		return c.Conn.Close()
+	}
+	c.closed = true
+	c.stopTimerLocked()
+	if len(c.buf) > 0 && c.err == nil {
+		data := c.buf
+		c.buf = nil
+		_ = c.flushLocked(data)
+	}
+	c.mu.Unlock()
+	return c.Conn.Close()
+}
+
+// SyscallConn keeps buf.NewReader's readv fast path reachable. Writes still go through Write:
+// net.Buffers.WriteTo and splice require a concrete *net.TCPConn, which this wrapper is not.
+func (c *conn) SyscallConn() (syscall.RawConn, error) {
+	if sc, ok := c.Conn.(syscall.Conn); ok {
+		return sc.SyscallConn()
+	}
+	return nil, errors.New("merge: underlying connection is not a syscall.Conn")
+}
diff --git a/transport/internet/finalmask/merge/conn_test.go b/transport/internet/finalmask/merge/conn_test.go
new file mode 100644
index 0000000..a23fdc8
--- /dev/null
+++ b/transport/internet/finalmask/merge/conn_test.go
@@ -0,0 +1,197 @@
+package merge
+
+import (
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+type fakeConn struct {
+	mu     sync.Mutex
+	writes [][]byte
+	reads  []byte
+	closed bool
+}
+
+func (f *fakeConn) Read(p []byte) (int, error) {
+	if len(f.reads) == 0 {
+		return 0, io.EOF
+	}
+	n := copy(p, f.reads)
+	f.reads = f.reads[n:]
+	return n, nil
+}
+
+func (f *fakeConn) Write(p []byte) (int, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.closed {
+		return 0, net.ErrClosed
+	}
+	f.writes = append(f.writes, append([]byte(nil), p...))
+	return len(p), nil
+}
+
+func (f *fakeConn) Close() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.closed = true
+	return nil
+}
+
+func (f *fakeConn) LocalAddr() net.Addr                { return nil }
+func (f *fakeConn) RemoteAddr() net.Addr               { return nil }
+func (f *fakeConn) SetDeadline(time.Time) error        { return nil }
+func (f *fakeConn) SetReadDeadline(time.Time) error    { return nil }
+func (f *fakeConn) SetWriteDeadline(time.Time) error   { return nil }
+
+func (f *fakeConn) snapshot() [][]byte {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	out := make([][]byte, len(f.writes))
+	copy(out, f.writes)
+	return out
+}
+
+func waitFor(t *testing.T, want int, f *fakeConn) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if len(f.snapshot()) >= want {
+			return
+		}
+		time.Sleep(2 * time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for %d write(s), saw %d", want, len(f.snapshot()))
+}
+
+func TestIdleTimerCoalescesWrites(t *testing.T) {
+	inner := &fakeConn{}
+	c := newConn(inner, &Config{Times: 1, DelayMs: 30, MaxBytes: 1 << 20})
+
+	if _, err := c.Write([]byte("hello ")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.Write([]byte("world")); err != nil {
+		t.Fatal(err)
+	}
+	if got := len(inner.snapshot()); got != 0 {
+		t.Fatalf("writes flushed before the idle window: %d", got)
+	}
+	waitFor(t, 1, inner)
+	if got := inner.snapshot(); string(got[0]) != "hello world" {
+		t.Fatalf("coalesced write = %q", got[0])
+	}
+}
+
+func TestMaxBytesForcesFlush(t *testing.T) {
+	inner := &fakeConn{}
+	c := newConn(inner, &Config{Times: 1, DelayMs: 5000, MaxBytes: 8})
+
+	c.Write([]byte("12345"))
+	if got := len(inner.snapshot()); got != 0 {
+		t.Fatalf("flushed under maxBytes: %d", got)
+	}
+	c.Write([]byte("67890"))
+	waitFor(t, 1, inner)
+	if got := inner.snapshot(); string(got[0]) != "1234567890" {
+		t.Fatalf("write = %q", got[0])
+	}
+}
+
+func TestBudgetThenPassThrough(t *testing.T) {
+	inner := &fakeConn{}
+	c := newConn(inner, &Config{Times: 1, DelayMs: 20, MaxBytes: 1 << 20})
+
+	c.Write([]byte("first"))
+	waitFor(t, 1, inner)
+
+	c.Write([]byte("second"))
+	if got := len(inner.snapshot()); got != 2 {
+		t.Fatalf("write after budget was buffered: %d writes", got)
+	}
+	if got := inner.snapshot()[1]; string(got) != "second" {
+		t.Fatalf("pass-through write = %q", got)
+	}
+}
+
+func TestCloseFlushesPendingBuffer(t *testing.T) {
+	inner := &fakeConn{}
+	c := newConn(inner, &Config{Times: 1, DelayMs: 5000, MaxBytes: 1 << 20})
+
+	c.Write([]byte("tail"))
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if got := inner.snapshot(); len(got) != 1 || string(got[0]) != "tail" {
+		t.Fatalf("close did not flush the buffer: %q", got)
+	}
+	if !inner.closed {
+		t.Fatal("close did not reach the inner connection")
+	}
+}
+
+func TestReadIsUntouched(t *testing.T) {
+	inner := &fakeConn{reads: []byte("server-bytes")}
+	c := newConn(inner, &Config{Times: 1, DelayMs: 5000, MaxBytes: 1 << 20})
+
+	buf := make([]byte, 32)
+	n, err := c.Read(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(buf[:n]) != "server-bytes" {
+		t.Fatalf("read = %q", buf[:n])
+	}
+}
+
+func TestStaleTimerDoesNotFlushTwice(t *testing.T) {
+	inner := &fakeConn{}
+	c := newConn(inner, &Config{Times: 3, DelayMs: 25, MaxBytes: 1 << 20})
+
+	for i := 0; i < 3; i++ {
+		c.Write([]byte{byte('a' + i)})
+		waitFor(t, i+1, inner)
+	}
+	time.Sleep(120 * time.Millisecond)
+	if got := len(inner.snapshot()); got != 3 {
+		t.Fatalf("stale timer produced extra writes: %d", got)
+	}
+	for i, w := range inner.snapshot() {
+		if len(w) != 1 || w[0] != byte('a'+i) {
+			t.Fatalf("write %d = %q", i, w)
+		}
+	}
+}
+
+func TestDefaults(t *testing.T) {
+	c := newConn(&fakeConn{}, &Config{}).(*conn)
+	if c.delay != 30*time.Millisecond {
+		t.Errorf("delay = %v", c.delay)
+	}
+	if c.maxBytes != 16*1024 {
+		t.Errorf("maxBytes = %d", c.maxBytes)
+	}
+	if c.left != 1 {
+		t.Errorf("times default = %d, want 1", c.left)
+	}
+
+	// Divergence from the reference implementation, pinned: zero means "one flush", not "unlimited".
+	c2 := newConn(&fakeConn{}, &Config{Times: 0}).(*conn)
+	if c2.left != 1 {
+		t.Errorf("Times=0 gave left=%d, want 1", c2.left)
+	}
+}
+
+func TestServerSideIsUntouched(t *testing.T) {
+	inner := &fakeConn{}
+	got, err := (&Config{Times: 1, DelayMs: 30}).WrapConnServer(inner)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != net.Conn(inner) {
+		t.Fatal("server side must be returned unchanged")
+	}
+}
