+// MergeMask is the JSON form of a merge TCP mask: coalesce the first outbound writes.
+type MergeMask struct {
+	Times    int32 `json:"times"`
+	DelayMs  int32 `json:"delayMs"`
+	MaxBytes int32 `json:"maxBytes"`
+}
+
+func (c *MergeMask) Build() (proto.Message, error) {
+	if c.Times < 0 {
+		return nil, errors.New("merge: times must be positive or zero (zero means one flush)")
+	}
+	if c.DelayMs < 0 || c.DelayMs > 5000 {
+		return nil, errors.New("merge: delayMs must be within 0..5000")
+	}
+	if c.MaxBytes < 0 || c.MaxBytes > 1<<20 {
+		return nil, errors.New("merge: maxBytes must be within 0..1048576")
+	}
+	return &merge.Config{Times: c.Times, DelayMs: c.DelayMs, MaxBytes: c.MaxBytes}, nil
+}
+
