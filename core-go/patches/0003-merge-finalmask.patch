+package merge
+
+import (
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet/finalmask"
+)
+
+const (
+	defaultTimes    = 1
+	defaultDelayMs  = 30
+	defaultMaxBytes = 16 * 1024
+)
+
+// WrapConnClient shapes the outbound side of a TCP connection.
+func (c *Config) WrapConnClient(inner net.Conn, _ *net.Destination, _ *finalmask.Dialer) (net.Conn, error) {
+	return newConn(inner, c), nil
+}
+
+// WrapConnServer leaves an inbound connection alone: merge only shapes what we send.
+func (c *Config) WrapConnServer(inner net.Conn) (net.Conn, error) {
+	return inner, nil
+}
